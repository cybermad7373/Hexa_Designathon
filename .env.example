# Copy this file to apps/web/.env before running the app:
#   npm run setup
#
# Never commit .env. Never put real production secrets in this repo.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
APP_VERSION=0.1.0
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database (matches docker-compose.yml defaults)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://hexa:hexa@localhost:5433/hexa?schema=public

# ---------------------------------------------------------------------------
# Redis (optional until you add queues, caching, or shared rate limits)
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------------
# Auth (required once an auth library is selected in Phase 05)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-a-32-byte-random-secret

# ---------------------------------------------------------------------------
# Email
# Local default: Mailpit (docker compose) at http://localhost:8025
# Production: set EMAIL_PROVIDER=resend with RESEND_API_KEY, or use SMTP.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
EMAIL_FROM="Hexa <no-reply@hexa.local>"
SMTP_URL=smtp://localhost:1025
# RESEND_API_KEY=re_...

# Protects the email queue processor endpoint. Change this everywhere.
CRON_SECRET=local-dev-cron-secret-change-me

# ---------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------
# SENTRY_DSN=
