{
  "name": "hexa-designathon",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Phase-gated 10-hour designathon operating system with a production-ready Next.js scaffold.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @hexa/web",
    "build": "npm run build --workspace @hexa/web",
    "start": "npm run start --workspace @hexa/web",
    "lint": "npm run lint --workspace @hexa/web",
    "typecheck": "npm run typecheck --workspace @hexa/web",
    "test": "npm run test --workspace @hexa/web",
    "test:coverage": "npm run test:coverage --workspace @hexa/web",
    "test:e2e": "npm run test:e2e --workspace @hexa/web",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "release:check": "node scripts/release-check.mjs",
    "prepare:submission": "node scripts/prepare-submission.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,css,yml,yaml}\"",
    "setup": "node scripts/setup.mjs",
    "verify": "node scripts/verify-setup.mjs",
    "db:up": "docker compose up -d db redis mailpit",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:push": "npm run db:push --workspace @hexa/web",
    "db:migrate": "npm run db:migrate --workspace @hexa/web",
    "db:deploy": "npm run db:deploy --workspace @hexa/web",
    "db:seed": "npm run db:seed --workspace @hexa/web",
    "db:studio": "npm run db:studio --workspace @hexa/web",
    "email:process": "node --env-file=apps/web/.env scripts/process-email.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "prettier": "^3.10.1"
  },
  "overrides": {
    "postcss": "^8.5.33",
    "effect": "3.22.5",
    "deepmerge-ts": "8.0.2"
  }
}
